{
	"info": {
		"_postman_id": "pemweb2-modul7-fiber-gorm",
		"name": "Pemweb2 Modul 7 - Fiber + GORM",
		"description": "Koleksi pengujian API Modul 7: Integrasi Fiber v3 dengan GORM dan MySQL.\n\nSemua endpoint membutuhkan header X-Api-Key.\n\nUrutan pengujian yang disarankan:\n1. Status API (tanpa API key)\n2. Program Studi - Daftar\n3. Mahasiswa - Buat\n4. Mahasiswa - Daftar (dengan pagination & filter)\n5. Mahasiswa - Detail by ID\n6. Mahasiswa - Cari by NIM\n7. Mahasiswa - Perbarui\n8. Mahasiswa - Hapus (soft delete)\n9. Mahasiswa - Pulihkan\n10. Matakuliah - Buat\n11. Matakuliah - Daftar\n12. Matakuliah - Detail\n13. Matakuliah - Perbarui\n14. Matakuliah - Hapus",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "apikey",
		"apikey": [
			{ "key": "key", "value": "X-Api-Key", "type": "string" },
			{ "key": "value", "value": "{{apiKey}}", "type": "string" },
			{ "key": "in", "value": "header", "type": "string" }
		]
	},
	"item": [
		{
			"name": "Status",
			"item": [
				{
					"name": "GET Status API",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/status",
						"description": "Memeriksa status API tanpa membutuhkan API key."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"Sukses true\", () => {",
									"    const data = pm.response.json();",
									"    pm.expect(data.sukses).to.be.true;",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET Status - Tanpa API Key (401)",
					"request": {
						"auth": { "type": "noauth" },
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/mahasiswa",
						"description": "Akses endpoint terproteksi tanpa API key harus mengembalikan 401."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 401 Unauthorized\", () => pm.response.to.have.status(401));",
									"pm.test(\"Sukses false\", () => {",
									"    const data = pm.response.json();",
									"    pm.expect(data.sukses).to.be.false;",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Program Studi",
			"item": [
				{
					"name": "GET Daftar Program Studi",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/program-studi",
						"description": "Mengambil daftar program studi beserta jumlah mahasiswa aktif."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
									"pm.test(\"Sukses true dan data array\", () => {",
									"    const data = pm.response.json();",
									"    pm.expect(data.sukses).to.be.true;",
									"    pm.expect(data.data).to.be.an('array');",
									"});",
									"pm.test(\"Field jumlah_mahasiswa ada\", () => {",
									"    const data = pm.response.json();",
									"    if (data.data.length > 0) {",
									"        pm.expect(data.data[0]).to.have.property('jumlah_mahasiswa');",
									"        pm.environment.set('programStudiId', data.data[0].id);",
									"    }",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Mahasiswa",
