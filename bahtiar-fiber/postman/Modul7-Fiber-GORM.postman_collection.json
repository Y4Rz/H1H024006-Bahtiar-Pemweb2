				{
					"name": "POST Buat Mahasiswa (berhasil)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"url": "{{baseUrl}}/api/mahasiswa",
						"body": {
							"mode": "raw",
							"raw": "{\n    \"program_studi_id\": {{programStudiId}},\n    \"nim\": \"H1H024006\",\n    \"nama\": \"Bahtiar Rizqi Efendy\",\n    \"email\": \"bahtiar@example.com\",\n    \"angkatan\": 2024,\n    \"ipk\": 3.75,\n    \"aktif\": true\n}",
							"options": { "raw": { "language": "json" } }
						},
						"description": "Membuat data mahasiswa baru. Menyimpan ID mahasiswa ke environment."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
									"pm.test(\"Sukses true dan data mahasiswa ada\", () => {",
									"    const data = pm.response.json();",
									"    pm.expect(data.sukses).to.be.true;",
									"    pm.expect(data.data).to.have.property('id');",
									"    pm.environment.set('mahasiswaId', data.data.id);",
									"    pm.environment.set('mahasiswaNim', data.data.nim);",
									"});"
								]
							}
						}
					]
				},
